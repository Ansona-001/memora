    "@mui/material": "^9.4.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "dayjs": "^1.11.23",
    "exifr": "^7.1.3",
    "framer-motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
